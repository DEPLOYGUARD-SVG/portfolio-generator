<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.fullName || 'Portfolio' %></title>
  <% if (embedded) { %>
  <style><%- css %></style>
  <% } else { %>
  <link rel="stylesheet" href="style.css">
  <% } %>
</head>
<body>
  <div class="layout">
    <!-- LEFT SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-inner">
        <!-- Photo / Avatar -->
        <div class="sidebar-photo">
          <% if (data.photo) { %>
          <img src="<%= data.photo %>" alt="<%= data.fullName %>" class="avatar">
          <% } else { %>
          <div class="avatar-placeholder"><%= (data.fullName || 'U').charAt(0) %></div>
          <% } %>
        </div>

        <!-- Name & Title -->
        <h1><%= data.fullName || 'Your Name' %></h1>
        <% if (data.title) { %><p class="subtitle"><%= data.title %></p><% } %>

        <!-- Personal Info -->
        <% if (data.dob || data.gender || data.nationality || data.drivingLicense) { %>
        <div class="sidebar-section">
          <h3>Personal Info</h3>
          <ul class="info-list">
            <% if (data.dob) { %><li><span class="info-label">Date of Birth</span><span class="info-value"><%= data.dob %></span></li><% } %>
            <% if (data.gender) { %><li><span class="info-label">Gender</span><span class="info-value"><%= data.gender %></span></li><% } %>
            <% if (data.nationality) { %><li><span class="info-label">Nationality</span><span class="info-value"><%= data.nationality %></span></li><% } %>
            <% if (data.drivingLicense) { %><li><span class="info-label">Driving License</span><span class="info-value"><%= data.drivingLicense %></span></li><% } %>
          </ul>
        </div>
        <% } %>

        <!-- Contact -->
        <% if (data.email || data.phone || data.address || data.city || data.country || data.postalCode) { %>
        <div class="sidebar-section">
          <h3>Contact</h3>
          <ul class="info-list">
            <% if (data.email) { %><li><span class="info-label">Email</span><span class="info-value"><a href="mailto:<%= data.email %>"><%= data.email %></a></span></li><% } %>
            <% if (data.phone) { %><li><span class="info-label">Phone</span><span class="info-value"><%= data.phone %></span></li><% } %>
            <% if (data.address) { %><li><span class="info-label">Address</span><span class="info-value"><%= data.address %></span></li><% } %>
            <% if (data.city || data.country) { %><li><span class="info-label">Location</span><span class="info-value"><%= [data.city, data.postalCode, data.country].filter(Boolean).join(', ') %></span></li><% } %>
          </ul>
        </div>
        <% } %>

        <!-- Social Links -->
        <% if (data.github || data.linkedin || data.twitter || data.website) { %>
        <div class="sidebar-section">
          <h3>Links</h3>
          <div class="sidebar-links">
            <% if (data.github) { %><a href="<%= data.github %>" target="_blank"><span class="link-icon">&#9679;</span> GitHub</a><% } %>
            <% if (data.linkedin) { %><a href="<%= data.linkedin %>" target="_blank"><span class="link-icon">&#9679;</span> LinkedIn</a><% } %>
            <% if (data.twitter) { %><a href="<%= data.twitter %>" target="_blank"><span class="link-icon">&#9679;</span> Twitter</a><% } %>
            <% if (data.website) { %><a href="<%= data.website %>" target="_blank"><span class="link-icon">&#9679;</span> Website</a><% } %>
          </div>
        </div>
        <% } %>

        <!-- Skills (progress bars) -->
        <% if (data.skills && data.skills.length > 0) { %>
        <div class="sidebar-section">
          <h3>Skills</h3>
          <div class="skill-bars">
            <% data.skills.forEach(function(skill) { %>
            <div class="skill-bar-item">
              <div class="skill-bar-header">
                <span><%= skill.name || '' %></span>
                <span class="skill-level-text"><%= skill.level || '' %></span>
              </div>
              <div class="skill-bar-track">
                <div class="skill-bar-fill" style="width: <%= skill.level === 'Expert' ? '100' : skill.level === 'Advanced' ? '80' : skill.level === 'Intermediate' ? '60' : skill.level === 'Beginner' ? '30' : '50' %>%"></div>
              </div>
              <% if (skill.category) { %><span class="skill-category"><%= skill.category %></span><% } %>
            </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Languages -->
        <% if (data.languages && data.languages.length > 0) { %>
        <div class="sidebar-section">
          <h3>Languages</h3>
          <div class="language-list">
            <% data.languages.forEach(function(lang) { %>
            <div class="language-item">
              <div class="language-header">
                <span class="language-name"><%= lang.name || '' %></span>
                <% if (lang.level) { %><span class="language-level"><%= lang.level %></span><% } %>
              </div>
              <% if (lang.listening || lang.reading || lang.speaking || lang.writing) { %>
              <div class="cefr-grid">
                <% if (lang.listening) { %><span class="cefr-tag">Listening: <%= lang.listening %></span><% } %>
                <% if (lang.reading) { %><span class="cefr-tag">Reading: <%= lang.reading %></span><% } %>
                <% if (lang.speaking) { %><span class="cefr-tag">Speaking: <%= lang.speaking %></span><% } %>
                <% if (lang.writing) { %><span class="cefr-tag">Writing: <%= lang.writing %></span><% } %>
              </div>
              <% } %>
            </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <main class="content">
      <!-- About -->
      <% if (data.about) { %>
      <section class="section">
        <h2>About Me</h2>
        <p class="about-text"><%= data.about %></p>
      </section>
      <% } %>

      <!-- Experience -->
      <% if (data.experience && data.experience.length > 0) { %>
      <section class="section">
        <h2>Experience</h2>
        <div class="timeline">
          <% data.experience.forEach(function(exp) { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="timeline-header">
                <h3><%= exp.position || '' %></h3>
                <span class="date"><%= exp.startDate || '' %> &mdash; <%= exp.endDate || 'Present' %></span>
              </div>
              <p class="company"><%= exp.company || '' %><% if (exp.location) { %> &middot; <%= exp.location %><% } %></p>
              <% if (exp.description) { %><p class="desc"><%= exp.description %></p><% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Education -->
      <% if (data.education && data.education.length > 0) { %>
      <section class="section">
        <h2>Education</h2>
        <div class="timeline">
          <% data.education.forEach(function(edu) { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="timeline-header">
                <h3><%= edu.degree || '' %></h3>
                <span class="date"><%= edu.startDate || '' %> &mdash; <%= edu.endDate || '' %></span>
              </div>
              <p class="company"><%= edu.school || '' %><% if (edu.location) { %> &middot; <%= edu.location %><% } %></p>
              <% if (edu.description) { %><p class="desc"><%= edu.description %></p><% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Projects -->
      <% if (data.projects && data.projects.length > 0) { %>
      <section class="section">
        <h2>Projects</h2>
        <div class="project-grid">
          <% data.projects.forEach(function(proj) { %>
          <div class="project-card">
            <div class="project-accent"></div>
            <h3><%= proj.name || '' %></h3>
            <% if (proj.description) { %><p class="desc"><%= proj.description %></p><% } %>
            <% if (proj.tech) { %>
            <div class="tech-tags"><% proj.tech.split(',').forEach(function(t) { %><span><%= t.trim() %></span><% }); %></div>
            <% } %>
            <div class="project-links">
              <% if (proj.demo) { %><a href="<%= proj.demo %>" target="_blank">Live Demo</a><% } %>
              <% if (proj.github) { %><a href="<%= proj.github %>" target="_blank">Source Code</a><% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Certifications -->
      <% if (data.certifications && data.certifications.length > 0) { %>
      <section class="section">
        <h2>Certifications</h2>
        <div class="entries">
          <% data.certifications.forEach(function(cert) { %>
          <div class="entry-card">
            <div class="entry-header">
              <h3><% if (cert.url) { %><a href="<%= cert.url %>" target="_blank"><%= cert.name || '' %></a><% } else { %><%= cert.name || '' %><% } %></h3>
              <% if (cert.date) { %><span class="date"><%= cert.date %></span><% } %>
            </div>
            <% if (cert.issuer) { %><p class="company"><%= cert.issuer %></p><% } %>
            <% if (cert.credentialId) { %><p class="credential-id">Credential ID: <%= cert.credentialId %></p><% } %>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Awards -->
      <% if (data.awards && data.awards.length > 0) { %>
      <section class="section">
        <h2>Awards</h2>
        <div class="entries">
          <% data.awards.forEach(function(award) { %>
          <div class="entry-card">
            <div class="entry-header">
              <h3><%= award.title || '' %></h3>
              <% if (award.date) { %><span class="date"><%= award.date %></span><% } %>
            </div>
            <% if (award.issuer) { %><p class="company"><%= award.issuer %></p><% } %>
            <% if (award.description) { %><p class="desc"><%= award.description %></p><% } %>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Volunteering -->
      <% if (data.volunteering && data.volunteering.length > 0) { %>
      <section class="section">
        <h2>Volunteering</h2>
        <div class="timeline">
          <% data.volunteering.forEach(function(vol) { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="timeline-header">
                <h3><%= vol.role || '' %></h3>
                <% if (vol.startDate || vol.endDate) { %><span class="date"><%= vol.startDate || '' %> &mdash; <%= vol.endDate || '' %></span><% } %>
              </div>
              <p class="company"><%= vol.organization || '' %></p>
              <% if (vol.description) { %><p class="desc"><%= vol.description %></p><% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- Interests -->
      <% if (data.interests) { %>
      <section class="section">
        <h2>Interests</h2>
        <p class="about-text"><%= data.interests %></p>
      </section>
      <% } %>

      <!-- References -->
      <% if (data.references && data.references.length > 0) { %>
      <section class="section">
        <h2>References</h2>
        <div class="references-grid">
          <% data.references.forEach(function(ref) { %>
          <div class="reference-card">
            <h3><%= ref.name || '' %></h3>
            <% if (ref.position) { %><p class="company"><%= ref.position %></p><% } %>
            <% if (ref.relationship) { %><p class="relationship"><%= ref.relationship %></p><% } %>
            <div class="reference-contact">
              <% if (ref.email) { %><a href="mailto:<%= ref.email %>"><%= ref.email %></a><% } %>
              <% if (ref.phone) { %><p><%= ref.phone %></p><% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>
    </main>
  </div>
</body>
</html>
